   para que siga asentándose cuando el recorte ya terminó. */
.img-reveal {
  display: block;
  overflow: hidden;
  clip-path: polygon(50% 100%, 50% 100%, 50% 100%, 50% 100%);
  transition: clip-path 1s cubic-bezier(0.165, 0.84, 0.44, 1);
}
.img-reveal img {
  display: block;
  transform: translateY(50%) scale(1.5);
  transition: transform 1.5s cubic-bezier(0.165, 0.84, 0.44, 1);
}
.img-reveal.in { clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%); }
.img-reveal.in img { transform: none; }

