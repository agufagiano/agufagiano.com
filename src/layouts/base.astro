  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: var(--text);
  color: var(--white);
  border: none;
  padding: 1rem 2rem;
  cursor: none;
  font-weight: 700;
  align-self: flex-start;
