<script>
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const coarsePointer = window.matchMedia('(pointer: coarse)').matches;

/* ── CURSOR ── */
const cursor = document.getElementById('cursor') as HTMLElement;
const ring   = document.getElementById('cursor-ring') as HTMLElement;
let mx = 0, my = 0, rx = 0, ry = 0;

function animateCursor() {
  cursor.style.left = mx + 'px';
  cursor.style.top  = my + 'px';
  rx += (mx - rx) * 0.12;
  ry += (my - ry) * 0.12;
  ring.style.left = rx + 'px';
  ring.style.top  = ry + 'px';
  requestAnimationFrame(animateCursor);
}

if (!reducedMotion && !coarsePointer) {
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
  animateCursor();

  document.querySelectorAll('a, button, .proyecto-item, .edu-card').forEach(el => {
    el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
    el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
  });
}

/* ── MOBILE MENU ── */
const navToggle  = document.getElementById('nav-toggle') as HTMLButtonElement;
const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

function setMenu(open: boolean) {
  document.body.classList.toggle('menu-open', open);
  navToggle.setAttribute('aria-expanded', String(open));
  navToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  mobileMenu.setAttribute('aria-hidden', String(!open));
}

navToggle.addEventListener('click', () => {
  setMenu(!document.body.classList.contains('menu-open'));
});

mobileMenu.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => setMenu(false));
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && document.body.classList.contains('menu-open')) setMenu(false);
});

/* ── LOADER ── */
const loader    = document.getElementById('loader') as HTMLElement;
const loaderBar = document.getElementById('loader-bar-fill') as HTMLElement;
const pct       = document.getElementById('loader-pct') as HTMLElement;
let count = 0;

function revealHero() {
  document.getElementById('main-nav')?.classList.add('visible');
  ['hero-tag', 'hn1', 'hn2', 'hero-title', 'hero-actions', 'hero-right']
    .forEach(id => document.getElementById(id)?.classList.add('in'));
}

function setProgress(val: number) {
  count = Math.min(val, 100);
  pct.textContent = count + '%';
  loaderBar.style.width = count + '%';
}

if (reducedMotion) {
  loader.classList.add('done');
  revealHero();
} else {
  const fakeInterval = setInterval(() => {
    setProgress(count + Math.floor(Math.random() * 10) + 4);
    if (count >= 90) clearInterval(fakeInterval);
  }, 100);

  window.addEventListener('load', () => {
    clearInterval(fakeInterval);
    setProgress(100);
    setTimeout(() => {
      loader.classList.add('done');
      setTimeout(revealHero, 200);
    }, 400);
  });
}

/* ── FOOTER YEAR ── */
const yearEl = document.getElementById('footer-year');
if (yearEl) yearEl.textContent = String(new Date().getFullYear());

/* ── SCROLL REVEALS ── */
/* threshold 0: los .reveal usan clip-path inset(0 100%) y Chrome puede reportarles
   intersectionRatio 0, así que un threshold > 0 es frágil. El rootMargin negativo
   mantiene el timing (no revelar justo en el borde del viewport). */
const revealObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const idx = parseInt((entry.target as HTMLElement).dataset.revealIdx ?? '0');
      (entry.target as HTMLElement).style.transitionDelay = ((idx % 6) * 0.07) + 's';
      entry.target.classList.add('in');
      revealObs.unobserve(entry.target);
    }
  });
}, { threshold: 0, rootMargin: '0px 0px -8% 0px' });

let revealIdx = 0;
document.querySelectorAll('.reveal, .slide-up').forEach(el => {
  (el as HTMLElement).dataset.revealIdx = String(revealIdx++);
  revealObs.observe(el);
});

/* ── IMAGE REVEAL ── */
/* Observador aparte del de .reveal: aquel escalona con transition-delay sobre
   el propio elemento, y acá el recorte del wrapper y el transform de la <img>
   tienen que arrancar juntos. Las imágenes del cuerpo salen del markdown, así
   que el wrapper que recorta se inserta en runtime y no en el template. */
if (!reducedMotion) {
  const imgObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        imgObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });

  document.querySelectorAll('.pr-body img, .cs-fig img').forEach(img => {
    const wrap = document.createElement('span');
    wrap.className = 'img-reveal';
    img.parentNode?.insertBefore(wrap, img);
    wrap.appendChild(img);
    imgObs.observe(wrap);
  });
}
</script>
